<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ======================= -->
    <!-- Typography Styles       -->
    <!-- ======================= -->
    <style name="TextAppearance.CoWall.Headline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/text_huge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CoWall.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_xxlarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CoWall.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CoWall.BodySecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CoWall.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="TextAppearance.CoWall.Headline.Giant" parent="TextAppearance.CoWall.Headline">
        <item name="android:textSize">@dimen/text_giant</item>
    </style>

    <!-- ======================= -->
    <!-- Widget Styles           -->
    <!-- ======================= -->
    <style name="Widget.CoWall.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="backgroundTint">@color/accent</item>
    </style>

    <style name="Widget.CoWall.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="strokeColor">@color/accent</item>
    </style>

    <style name="Widget.CoWall.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:padding">@dimen/spacing_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_large</item>
    </style>
</resources>
