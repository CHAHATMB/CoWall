<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CoWall" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bg_card</item>
        <item name="colorSecondaryVariant">@color/bg_surface</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg_surface</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Global Component Styles -->
        <item name="materialButtonStyle">@style/Widget.CoWall.Button.Primary</item>
        <item name="editTextStyle">@style/Widget.CoWall.EditText</item>
    </style>

    <style name="Theme.CoWall.PhotoView" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
