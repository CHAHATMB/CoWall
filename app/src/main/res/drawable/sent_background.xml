<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tail: 12×12dp rotated square; right half visible as a right-pointing triangle -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="end|top">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/bubble_sent" />
            </shape>
        </rotate>
    </item>
    <!-- Main bubble body, inset 6dp from end so tail triangle is exposed -->
    <item android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_sent" />
            <corners
                android:topLeftRadius="@dimen/radius_medium"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/radius_medium"
                android:bottomRightRadius="@dimen/radius_medium" />
        </shape>
    </item>
</layer-list>
