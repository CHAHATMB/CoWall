<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tail: 12×12dp rotated square; left half visible as a left-pointing triangle -->
    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="start|top">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/bubble_received" />
            </shape>
        </rotate>
    </item>
    <!-- Main bubble body, inset 6dp from start so tail triangle is exposed -->
    <item android:left="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_received" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="@dimen/radius_medium"
                android:bottomLeftRadius="@dimen/radius_medium"
                android:bottomRightRadius="@dimen/radius_medium" />
        </shape>
    </item>
</layer-list>
