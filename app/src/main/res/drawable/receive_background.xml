<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tail triangle on the left -->
    <item
        android:left="-6dp"
        android:top="@dimen/spacing_small"
        android:width="12dp"
        android:height="12dp"
        android:gravity="start|top">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <solid android:color="@color/bubble_received" />
            </shape>
        </rotate>
    </item>
    <!-- Main bubble body -->
    <item android:left="@dimen/spacing_micro">
        <shape android:shape="rectangle">
            <solid android:color="@color/bubble_received" />
            <corners
                android:topLeftRadius="@dimen/spacing_micro"
                android:topRightRadius="@dimen/radius_medium"
                android:bottomLeftRadius="@dimen/radius_medium"
                android:bottomRightRadius="@dimen/radius_medium" />
        </shape>
    </item>
</layer-list>
