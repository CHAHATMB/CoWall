<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tool="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:gravity="start|bottom"
    android:paddingHorizontal="12dp"
    android:paddingVertical="@dimen/spacing_micro">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/partnerAvatarImage"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/Circular"
        android:visibility="gone"
        tool:visibility="visible" />

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/receive_background"
        android:padding="6dp">

        <TextView
            android:id="@+id/senderNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_micro"
            android:paddingBottom="2dp"
            android:textColor="@color/accent"
            android:textSize="11sp"
            tool:text="Sender Name"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/replyPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_surface"
            android:padding="6dp"
            android:layout_marginBottom="@dimen/spacing_micro"
            tool:visibility="visible"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/accent"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/replyPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small"
                android:maxLines="2"
                tool:text="Reply Preview"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/receiveImageView"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            tool:visibility="gone"
            android:visibility="gone" />

        <TextView
            android:id="@+id/captionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_micro"
            android:paddingTop="@dimen/spacing_micro"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_medium"
            tool:text="Caption"
            tool:visibility="visible"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewReceive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_micro"
            android:paddingVertical="2dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tool:text="Text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timestampText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingTop="@dimen/spacing_micro"
            android:paddingHorizontal="@dimen/spacing_micro"
            tool:text="tiem"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_micro" />

        <TextView
            android:id="@+id/reactionsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_micro"
            android:background="@drawable/reaction_pill_background"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
