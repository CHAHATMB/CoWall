<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:paddingHorizontal="12dp"
    android:paddingVertical="@dimen/spacing_micro">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/sent_background"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/replyPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/accent_dark"
            android:padding="6dp"
            android:layout_marginBottom="@dimen/spacing_micro"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/text_primary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/replyPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sentImageView"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            android:visibility="gone" />

        <TextView
            android:id="@+id/captionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_micro"
            android:paddingTop="@dimen/spacing_micro"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_medium"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textViewSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_micro"
            android:paddingVertical="2dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_micro"
            android:paddingHorizontal="@dimen/spacing_micro">

            <TextView
                android:id="@+id/timestampText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_micro" />

            <ImageView
                android:id="@+id/statusIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="@dimen/spacing_micro"
                android:src="@drawable/ic_done"
                app:tint="@color/status_tick" />
        </LinearLayout>

        <TextView
            android:id="@+id/reactionsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_micro"
            android:background="@drawable/reaction_pill_background"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
