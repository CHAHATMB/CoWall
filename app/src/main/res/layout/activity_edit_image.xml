<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fitsSystemWindows="true"
    tools:context=".activities.EditImageActivity">

    <!-- Top bar -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="?actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_surface"
        android:padding="@dimen/spacing_small"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageBack"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Edit Image"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_xlarge"
            android:paddingStart="@dimen/spacing_small"
            android:gravity="center_vertical"
            app:fontFamily="sans-serif" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageSave"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            app:srcCompat="@drawable/ic_done"
            app:tint="@color/white" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- Image container: holds imagePreview + all edit overlays -->
    <FrameLayout
        android:id="@+id/imageContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/toolPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/new_wallpaper"
            android:visibility="visible" />

        <ProgressBar
            android:id="@+id/previewProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- Drawing canvas — transparent overlay, receives touch only in DRAW mode -->
        <com.example.cowall.DrawingCanvasView
            android:id="@+id/drawingCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Draggable text overlay — visible when user has typed text -->
        <TextView
            android:id="@+id/textOverlayPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingVertical="@dimen/spacing_small"
            android:background="@drawable/text_overlay_background"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom tool panel -->
    <LinearLayout
        android:id="@+id/toolPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- 5-tab tool selector row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabFilters"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_gallery_grid"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/textTabFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filters"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabIntensity"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_tune"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/textTabIntensity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Strength"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabTint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_palette"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/textTabTint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tint"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_text_fields"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/textTabText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabDraw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:srcCompat="@drawable/ic_brush"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/textTabDraw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Draw"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

        </LinearLayout>

        <!-- Filters panel (default visible) -->
        <FrameLayout
            android:id="@+id/panelFilters"
            android:layout_width="match_parent"
            android:layout_height="110dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingTop="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_small"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_container_filter" />

            <ProgressBar
                android:id="@+id/imageFiltersProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Intensity panel -->
        <LinearLayout
            android:id="@+id/panelIntensity"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/spacing_large"
            android:paddingVertical="@dimen/spacing_medium"
            android:visibility="gone">

            <TextView
                android:id="@+id/textIntensityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filter Strength: 100%"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_medium"
                android:layout_marginBottom="@dimen/spacing_small" />

            <SeekBar
                android:id="@+id/seekBarIntensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />
        </LinearLayout>

        <!-- Tint panel -->
        <LinearLayout
            android:id="@+id/panelTint"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tintColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/spacing_micro">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="Opacity"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />

                <SeekBar
                    android:id="@+id/seekBarTintOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="40"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- Text overlay panel -->
        <LinearLayout
            android:id="@+id/panelText"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <EditText
                android:id="@+id/editOverlayText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:hint="Type your caption — drag it on the image"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:background="@drawable/input_background"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingVertical="@dimen/spacing_small"
                android:textSize="@dimen/text_medium" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingTop="@dimen/spacing_small">

                <LinearLayout
                    android:id="@+id/textColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Draw / doodle panel -->
        <LinearLayout
            android:id="@+id/panelDraw"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_small"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:visibility="gone">

            <!-- Brush color swatches -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/brushColorRow"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- Brush size + undo + clear -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="Size"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_small" />

                <SeekBar
                    android:id="@+id/seekBarBrushSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="40"
                    android:progress="8"
                    android:progressTint="@color/accent"
                    android:thumbTint="@color/accent" />

                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Undo"
                    app:srcCompat="@drawable/ic_undo"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnClearDoodle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="@dimen/spacing_micro"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear all"
                    app:srcCompat="@drawable/ic_close"
                    app:tint="@color/text_primary" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
