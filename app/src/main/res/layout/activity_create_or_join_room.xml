<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootConstraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:fitsSystemWindows="true"
    tools:context=".CreateOrJoinRoom">

    <!-- ===== SCREEN 1: Setup ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/createRoomCL"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CoWall"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_huge"
            app:fontFamily="cursive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.08" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Connect with your partner"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleText" />

        <!-- Name input -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/yourName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:gravity="center"
            android:hint="Your name"
            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.32" />

        <!-- Create / Join toggle -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:checkedButton="@id/btnCreateMode"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/yourName"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnCreateMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_space"
                android:textAllCaps="false"
                android:textSize="@dimen/text_medium" />

            <Button
                android:id="@+id/btnJoinMode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/join_space"
                android:textAllCaps="false"
                android:textSize="@dimen/text_medium" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Join section: code input + QR scan — hidden in create mode -->
        <LinearLayout
            android:id="@+id/joinSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/modeToggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRoomId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="Partner's Space Code"
                android:inputType="phone"
                android:minHeight="52dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <ImageButton
                android:id="@+id/scanQrButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/hint_card_bg"
                android:contentDescription="Scan QR code"
                android:padding="12dp"
                android:src="@drawable/ic_baseline_camera_24"
                android:tint="@color/text_primary" />

        </LinearLayout>

        <Button
            android:id="@+id/submitButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="20dp"
            android:text="@string/create_space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/joinSection" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===== SCREEN 2: Waiting for partner ===== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/waitingRoomCS"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/waiting_gradient"
        android:visibility="invisible"
        tools:context=".CreateOrJoinRoom">

        <TextView
            android:id="@+id/titleTextCS"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_marginEnd="@dimen/spacing_small"
            android:text="Waiting for your partner..."
            android:textColor="#fff"
            android:textSize="26sp"
            app:fontFamily="cursive"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/exitButtonCS"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.06" />

        <ImageButton
            android:id="@+id/exitButtonCS"
            android:layout_width="@dimen/spacing_xxlarge"
            android:layout_height="@dimen/spacing_xxlarge"
            android:layout_marginEnd="@dimen/spacing_medium"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="@dimen/spacing_xxlarge"
            android:minHeight="@dimen/spacing_xxlarge"
            android:src="@drawable/ic_baseline_exit"
            app:layout_constraintBottom_toBottomOf="@id/titleTextCS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/titleTextCS"
            tools:ignore="SpeakableTextPresentCheck" />

        <!-- Instruction for the user -->
        <TextView
            android:id="@+id/waitingInstructionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xlarge"
            android:layout_marginEnd="@dimen/spacing_xlarge"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Ask your partner to scan the QR code or enter the code below"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleTextCS" />

        <!-- Elapsed waiting time -->
        <TextView
            android:id="@+id/waitingTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="@string/waiting_just_started"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/waitingInstructionText" />

        <!-- QR code for partner to scan -->
        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="12dp"
            android:padding="10dp"
            android:background="@drawable/qr_white_card"
            android:contentDescription="QR code to join this space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/waitingTimerText" />

        <!-- "YOUR SPACE CODE" label above the big code -->
        <TextView
            android:id="@+id/codeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.12"
            android:text="YOUR SPACE CODE"
            android:textAllCaps="true"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            app:layout_constraintBottom_toTopOf="@id/yourRoomIdCS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@id/qrCodeImage"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Big pulsing code -->
        <TextView
            android:id="@+id/yourRoomIdCS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="@dimen/spacing_small"
            android:paddingBottom="@dimen/spacing_small"
            android:text="0000-0000"
            android:textColor="@color/accent"
            style="@style/TextAppearance.CoWall.Headline.Giant"
            
            app:fontFamily="monospace"
            app:layout_constraintBottom_toTopOf="@id/tapToCopyHintCS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/codeLabel" />

        <!-- Tap to copy hint -->
        <TextView
            android:id="@+id/tapToCopyHintCS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap to copy"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@id/shareButtonCS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/yourRoomIdCS" />

        <!-- Remind / share button -->
        <Button
            android:id="@+id/shareButtonCS"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/button_white_pill"
            android:text="Remind your partner"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_large"
            app:layout_constraintBottom_toTopOf="@id/stepsCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tapToCopyHintCS"
            app:layout_constraintVertical_bias="0.3" />

        <!-- Partner quick-guide hint -->
        <TextView
            android:id="@+id/stepsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/hint_card_bg"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/waiting_steps_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
